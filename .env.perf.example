PERF_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# MUST be a database dedicated to non-production use (a separate Neon
# project/branch, a disposable local Postgres instance, etc.) — never the
# same value as .env's DATABASE_URL. perf/run.mjs refuses to run if this
# file is missing, if PERF_DATABASE_URL is unset, or if it matches .env's
# DATABASE_URL exactly.
