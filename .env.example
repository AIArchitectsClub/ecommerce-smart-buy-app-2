DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=3001
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Observability (OpenTelemetry -> Grafana). See docker-compose.observability.yml
# and README.md's "Observability" section. Leave OTEL_ENABLED unset/false to
# run with no instrumentation overhead (this is the default for all test suites).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=smartbuy-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Incident exercise (all optional; see incident-demo/README.md)
# EXPRESS_PAY_ENABLED=true   enables the Express Pay route and button
# DB_POOL_MAX=5              small connection pool
# DB_CONNECT_TIMEOUT_MS=5000 fail instead of waiting forever for a connection
# OTEL_SERVICE_NAME=checkout-service
# OTEL_METRIC_EXPORT_INTERVAL=10000   export metrics every 10s (default 60s) so 1-minute rate queries have data
