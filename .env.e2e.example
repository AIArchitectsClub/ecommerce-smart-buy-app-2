E2E_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# MUST be a database dedicated to non-production use, and ideally distinct
# from PERF_DATABASE_URL too (separate Neon project/branch, disposable
# local Postgres, etc.) — never the same value as .env's DATABASE_URL.
# playwright.config.js refuses to boot the app if this file is missing,
# if E2E_DATABASE_URL is unset, or if it matches .env's DATABASE_URL.
